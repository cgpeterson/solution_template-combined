<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>01187a1e-41d9-4585-809d-b1902c8677e0</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Shared.Proxies</Import_RootNamespace>
  </PropertyGroup>
  <!--
    Wildcards, not per-file entries: Plugins\codgen\proxybuilder.bat regenerates these
    folders (one file per entity, global option set and message), so an explicit list
    would silently stop compiling any proxy added after the last manual edit.
  -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)CrmServiceContext.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Entities\*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)GlobalEnums\*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Messages\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="$(MSBuildThisFileDirectory)Entities\" />
    <Folder Include="$(MSBuildThisFileDirectory)GlobalEnums\" />
    <Folder Include="$(MSBuildThisFileDirectory)Messages\" />
  </ItemGroup>
</Project>