<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- Connection Settings Start -->
    <!--
      AuthType=Office365 (username/password over WS-Trust) is retired for Dataverse online; use OAuth.
      Live mode (UseLocalCrmDatabase=false) connects through XrmUnitTest's CrmServiceClient, which is
      still ADAL-based; XrmUnitTest.09 has no hook to substitute an MSAL ServiceClient. Omit the
      Password settings to get an interactive sign-in instead of a username/password sign-in.
    -->
    <!--
      Settings:
        ConnectionPrefix - Prefix used to determine which connection string to use
        {ConnectionPrefix}ConnectionString - The Connection string to use
        Password - Password for all connection strings
        {ConnectionPrefix}Password - Password for a particular connection string
        UseLocalCrmDatabase - This controls if TestBase.GetOrganizationService returns a connection to an actual CRM, or if it returns a connection to an "In Memory" CRM.    
    -->
    <add key="UseLocalCrmDatabase" value="true"/>

    <add key="ConnectionPrefix" value="Dev."/>

    <add key="Dev.ConnectionString" value="AuthType=OAuth;Username=jsmith@contoso.onmicrosoft.com; Url=https://dev.contoso.crm.dynamics.com; AppId=51f81489-12ee-4a9e-aaae-a2591f45987d; RedirectUri=app://58145B91-0C36-4500-8554-080854F2AC97; LoginPrompt=Auto"/>
    <add key="Qa.ConnectionString" value="AuthType=OAuth;Username=jsmith@contoso.onmicrosoft.com; Url=https://qa.contoso.crm.dynamics.com; AppId=51f81489-12ee-4a9e-aaae-a2591f45987d; RedirectUri=app://58145B91-0C36-4500-8554-080854F2AC97; LoginPrompt=Auto"/>
    <add key="Stage.ConnectionString" value="AuthType=OAuth;Username=jsmith@contoso.onmicrosoft.com; Url=https://stage.contoso.crm.dynamics.com; AppId=51f81489-12ee-4a9e-aaae-a2591f45987d; RedirectUri=app://58145B91-0C36-4500-8554-080854F2AC97; LoginPrompt=Auto"/>
    <add key="Prod.ConnectionString" value="AuthType=OAuth;Username=jsmith@contoso.onmicrosoft.com; Url=https://prod.contoso.crm.dynamics.com; AppId=51f81489-12ee-4a9e-aaae-a2591f45987d; RedirectUri=app://58145B91-0C36-4500-8554-080854F2AC97; LoginPrompt=Auto"/>


    <!-- Connection Settings End -->

    <!-- Format of FullName
      F = First Name
      M = Middle Name
      I = Middle Initial 
      L = Last Name
    -->
    <add key="CrmSystemSettings.FullNameFormat" value="F I L"/>

    
    <!-- Use if you have a single password for all orgs -->
    <add key="Password" value="MyPassword"/>
    <!-- Use if you have seperate passwords per org -->
    <!--
    <add key="Dev.Password" value="MyPassword"/>
    <add key="Qa.Password" value="MyPassword"/>
    <add key="Stage.Password" value="MyPassword"/>
    <add key="Prod.Password" value="MyPassword"/>
    -->
  </appSettings>
</configuration>
