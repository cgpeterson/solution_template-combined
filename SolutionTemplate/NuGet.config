<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!--
      Keeps PackageReference restores landing in a solution-relative packages\
      folder instead of the global NuGet cache. Plugins\codgen\proxybuilder.bat
      and Plugins\spkl\deploy-plugins.bat locate their tools by recursively
      searching the solution folder tree for proxybuilder.exe / spkl.exe; both
      packages only converted to PackageReference (from packages.config)
      because the JMCL .Sources packages require it. Removing this setting
      would silently break those two scripts.

      The key must be globalPackagesFolder. NuGet.config has no
      restorePackagesPath setting (that is the MSBuild property
      RestorePackagesPath); NuGet silently ignores unknown keys and restores to
      the global cache, where neither script can find its tool.
    -->
    <add key="globalPackagesFolder" value="packages" />
  </config>
  <packageSources>
    <!--
      Declared here so "nuget.exe restore -ConfigFile NuGet.config" has a source;
      -ConfigFile reads only this file. Sources from user-level config still apply
      to Visual Studio and plain "nuget.exe restore".
    -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
