<?xml version="1.0"?>
<package>
  <metadata minClientVersion="3.3.0">
    <id>[clientprefix].Cds.[solutionname].Sources</id>
    <version>$version$</version>
    <description>CDS dependency artifacts for the [solutionname] solution.</description>
    <authors>[clientprefix]</authors>
    <owners>[clientname]</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>    
    <tags></tags>
    <dependencies>      
      <!--<dependency id="xxxxx.Sources" version="1.0.0.2" />-->
    </dependencies>
  </metadata>
  <files>
    <file src="temp\packed\[solutionname]_managed.zip" target="content/CdsDependencies/[solutionname]_$version$/[solutionname]_managed.zip" />    
   <!-- <file src="temp\packed\ConfigData.zip" target="content/CdsDependencies/[solutionname]_$version$/ConfigData.zip" />
    <file src="temp\packed\TestData.zip" target="content/CdsDependencies/[solutionname]Core_$version$/TestData.zip" /> -->
  </files>
</package>
